<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C7D3D9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#F7FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_extrabold"
                    android:gravity="center"
                    android:text="Place an Order"
                    android:textColor="#102A3A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Add Items"
                    android:textColor="#102A3A"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/item_name"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Item name"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/item_price_estimate"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_rounded"
                        android:hint="Price est."
                        android:inputType="numberDecimal"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />

                    <EditText
                        android:id="@+id/item_quantity"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_rounded"
                        android:hint="Quantity"
                        android:inputType="number"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/add_item"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#71D7C7"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Add Item"
                    android:textColor="#071B25"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/item_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />

                <EditText
                    android:id="@+id/delivery_address"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Delivery location"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <EditText
                    android:id="@+id/preferred_store"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Preferred store (optional)"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <EditText
                    android:id="@+id/order_notes"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:gravity="top"
                    android:hint="Notes for the shopper"
                    android:inputType="textMultiLine"
                    android:padding="16dp" />

                <Button
                    android:id="@+id/submit_order"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#84C8FF"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Submit Order"
                    android:textColor="#071B25"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
