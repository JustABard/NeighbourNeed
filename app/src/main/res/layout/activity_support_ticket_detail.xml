<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C7D3D9">

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        app:cardBackgroundColor="#F7FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/support_ticket_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_extrabold"
                android:gravity="center"
                android:text="Support Ticket"
                android:textColor="#102A3A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/support_ticket_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#5A6870"
                android:textSize="15sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/support_ticket_messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#102A3A"
                    android:textSize="16sp" />
            </ScrollView>

            <EditText
                android:id="@+id/support_reply_input"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/edittext_rounded"
                android:hint="Write a reply"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <Button
                android:id="@+id/send_support_reply"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#84C8FF"
                android:fontFamily="@font/sora_extrabold"
                android:text="Send Reply"
                android:textColor="#071B25"
                android:textStyle="bold" />

            <Button
                android:id="@+id/refresh_support_ticket"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#71D7C7"
                android:fontFamily="@font/sora_extrabold"
                android:text="Refresh"
                android:textColor="#071B25"
                android:textStyle="bold" />

            <Button
                android:id="@+id/close_support_ticket"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#E57373"
                android:fontFamily="@font/sora_extrabold"
                android:text="Close Ticket"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
