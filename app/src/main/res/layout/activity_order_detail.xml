<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C7D3D9">

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        app:cardBackgroundColor="#F7FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sora_extrabold"
                android:gravity="center"
                android:text="Request Details"
                android:textColor="#102A3A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/order_detail_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#102A3A"
                    android:textSize="16sp" />
            </ScrollView>

            <Button
                android:id="@+id/open_maps"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#84C8FF"
                android:fontFamily="@font/sora_extrabold"
                android:text="Open Location in Maps"
                android:textColor="#071B25"
                android:textStyle="bold" />

            <Button
                android:id="@+id/take_order"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#71D7C7"
                android:fontFamily="@font/sora_extrabold"
                android:text="Take Request"
                android:textColor="#071B25"
                android:textStyle="bold" />

            <Button
                android:id="@+id/complete_order"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#F6C86E"
                android:fontFamily="@font/sora_extrabold"
                android:text="Mark Completed"
                android:textColor="#071B25"
                android:textStyle="bold" />

            <Button
                android:id="@+id/view_volunteer_profile"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#D6C7FF"
                android:fontFamily="@font/sora_extrabold"
                android:text="Volunteer Profile"
                android:textColor="#071B25"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
