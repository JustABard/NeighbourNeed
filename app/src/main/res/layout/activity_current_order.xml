<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C7D3D9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="#F7FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_extrabold"
                    android:gravity="center"
                    android:text="Current Order"
                    android:textColor="#102A3A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/current_order_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Loading..."
                    android:textColor="#102A3A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/current_order_messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="#102A3A"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/current_order_message_input"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Message shopper"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <Button
                    android:id="@+id/send_current_order_message"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#84C8FF"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Send Message"
                    android:textColor="#071B25"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/refresh_current_order"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#71D7C7"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Refresh"
                    android:textColor="#071B25"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/track_shopper"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#F6C86E"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Track Shopper"
                    android:textColor="#071B25"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/cancel_order"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#E57373"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Cancel Order"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/current_order_volunteer_profile"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#D6C7FF"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Volunteer Profile"
                    android:textColor="#071B25"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
