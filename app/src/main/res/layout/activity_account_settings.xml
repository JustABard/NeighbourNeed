<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C7D3D9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#F7FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sora_extrabold"
                    android:gravity="center"
                    android:text="Account Settings"
                    android:textColor="#102A3A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/account_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Full name"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <EditText
                    android:id="@+id/account_default_location"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:hint="Default delivery location"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <CheckBox
                    android:id="@+id/bold_text_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Use bold text for easier reading"
                    android:textColor="#102A3A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/account_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#102A3A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/account_user_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#102A3A"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/save_account"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#D6C7FF"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Save Changes"
                    android:textColor="#071B25"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/delete_account"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#E57373"
                    android:fontFamily="@font/sora_extrabold"
                    android:text="Delete Account"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
